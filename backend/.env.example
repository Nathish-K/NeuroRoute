# NeuroRoute backend environment template.
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=neuroroute

# --- Gemini ---
# Never commit a real key. Sent only in the x-goog-api-key header.
# Backend only: never expose it to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Ollama (local model: qwen2.5:3b) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Groq ---
# Never commit a real key. Sent only in the Authorization header.
# Backend only: never expose it to the frontend.
GROQ_API_KEY=

# --- Routing ---
# Allowed: cost_optimised, quality_optimised, baseline
ROUTING_POLICY=cost_optimised

# Optional model-registry identifiers (leave empty to unset)
BASELINE_MODEL_ID=
FALLBACK_MODEL_ID=

# Must be a number between 0.0 and 1.0.
# The app will refuse to start without it once Task 7.1 lands.
ESCALATION_CONFIDENCE_THRESHOLD=0.5
